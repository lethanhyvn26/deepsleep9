<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DeepSleep" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/midnight_blue</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorPrimary">@color/pastel_purple</item>
    </style>

    <style name="Theme.DeepSleep.Splash" parent="Theme.DeepSleep">
        <item name="android:windowBackground">@color/midnight_blue</item>
    </style>
</resources>
